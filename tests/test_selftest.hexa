#!hexa strict
// tests/test_selftest.hexa — full 11-doc selftest harness for hexa-mobility
//
// Pass criterion: __HEXA_MOBILITY_SELFTEST__ PASS sentinel present
// (and 11 docs accounted for under docs/).
//
// Cost: $0 (orchestrates the placeholder dispatcher; no numerical work).

let VERB_PARENT = "docs"
let VERB_DOCS: [str] = [
    "autonomous-driving.md",
    "electric-vehicle.md",
    "control-automation.md",
    "fun-car.md",
    "cartography-gis.md",
    "robotics.md",
    "robotics-transport.md",
    "motorcycle.md",
    "ultimate-safety.md",
    "battery-scale-6-ev.md",
    "governance-safety-urban.md",
]

fn _file_exists(p: str) -> bool {
    let r = exec("[ -f \"" + p + "\" ] && echo yes || echo no").trim()
    return r == "yes"
}

fn main() {
    let mut root = env("HEXA_MOBILITY_ROOT")
    if root.len() == 0 { root = exec("pwd").trim() }

    // ── direct doc-presence check (offline guard) ──
    let mut missing: [str] = []
    for d in VERB_DOCS {
        if _file_exists(root + "/" + VERB_PARENT + "/" + d) == false { missing = missing + [d] }
    }
    let n_present = 11 - missing.len()
    println("test_selftest: docs present = " + str(n_present) + " / 11")
    if missing.len() > 0 {
        println("test_selftest: FAIL — missing docs:")
        for m in missing { println("  - " + m) }
        exit(1)
    }

    // ── CLI round-trip via dispatcher ──
    let cli = root + "/cli/hexa-mobility.hexa"
    let cli_ok = exec("[ -f \"" + cli + "\" ] && echo y || echo n").trim()
    if cli_ok != "y" {
        println("test_selftest: FAIL — cli/hexa-mobility.hexa missing")
        exit(1)
    }

    let cmd = "HEXA_MOBILITY_ROOT=\"" + root + "\" hexa run \"" + cli + "\" selftest 2>&1"
    let raw = exec(cmd)
    if raw.contains("__HEXA_MOBILITY_SELFTEST__ PASS") {
        println("test_selftest: PASS — 11/11 docs + dispatcher sentinel OK")
        return
    }
    println("test_selftest: FAIL — sentinel not found")
    println(raw.trim())
    exit(1)
}
