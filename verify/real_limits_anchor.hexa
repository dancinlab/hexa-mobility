#!hexa strict
// hexa-mobility/verify/real_limits_anchor.hexa — real-limits-first anchor.
//
// Per LATTICE_POLICY.md §1.3 rule 2: each project's verify must use at
// least one anchor from §1.2 (Shannon · Kolmogorov · Bekenstein · c · ℏ ·
// k · Stefan-Boltzmann · Carnot · ASML throughput · ERCOT · etc.) and
// at least one engineering/industry threshold.
//
// Stage-5 mobility anchors (raw#10 C3):
//   - SAE J3016 L0–L5 taxonomy (autonomy levels — STANDARD)
//   - ISO 26262 ASIL A/B/C/D ratings (functional safety — STANDARD)
//   - NCAP / IIHS crash-test scores (independent safety protocol)
//   - NHTSA FARS baseline ~1.3 fatality / 100M VMT (H9 statistical)
//   - Braess's paradox (H5 network theory; Braess 1968)
//   - Battery energy density 300 Wh/kg cell (H1 electrochemistry)
//   - Tire–road friction μ ≤ 1.0 (H4 contact mechanics)
//   - V2X light-cone c = 3×10⁸ m/s (H8 SR limit)
//
// hexa-mobility's real-limits audit lives in LIMIT_BREAKTHROUGH.md
// (Wave M, 2026-05-12). This script confirms that file is present and
// references the canonical autonomous-mobility HARD walls.
//
// Honesty: no value here is computed against the n=6 lattice. Each
// constant is sourced from SAE / ISO / NHTSA / Braess 1968 / Goodenough /
// Janek / Vickrey / Waymo public reports as cited in LIMIT_BREAKTHROUGH.md.

let HOME = env("HOME")
let HEXA_MOBILITY_ROOT_ENV = env("HEXA_MOBILITY_ROOT")

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _resolve_root() -> str {
    if HEXA_MOBILITY_ROOT_ENV.len() > 0 { return HEXA_MOBILITY_ROOT_ENV }
    let oldpwd = env("OLDPWD")
    if oldpwd.len() > 0 {
        let t = exec("[ -f " + shq(oldpwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return oldpwd }
    }
    let pwd = env("PWD")
    if pwd.len() > 0 {
        let t = exec("[ -f " + shq(pwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return pwd }
    }
    return HOME + "/core/hexa-mobility"
}

fn _file_exists(p: str) -> bool {
    let r = exec("[ -f " + shq(p) + " ] && echo yes || echo no").trim()
    return r == "yes"
}

fn _file_contains(p: str, needle: str) -> bool {
    let cmd = "grep -F " + shq(needle) + " " + shq(p) + " >/dev/null 2>&1 && echo yes || echo no"
    let r = exec(cmd).trim()
    return r == "yes"
}

fn main() {
    let root = _resolve_root()
    println("hexa-mobility/verify/real_limits_anchor — real-limits-first check")
    println("  root: " + root)
    println("")
    println("  policy: LATTICE_POLICY §1.3 rule 2 — at least 1 real limit anchor required")
    println("  source: LIMIT_BREAKTHROUGH.md (Wave M, Stage-5 mobility audit)")
    println("")

    let mut ok = 0
    let mut bad = 0

    // 1. Audit file must exist.
    let audit = root + "/LIMIT_BREAKTHROUGH.md"
    if _file_exists(audit) {
        println("  [PASS] LIMIT_BREAKTHROUGH.md present")
        ok = ok + 1
    } else {
        println("  [FAIL] LIMIT_BREAKTHROUGH.md missing (abs: " + audit + ")")
        bad = bad + 1
    }

    // 2. Audit must reference canonical mobility HARD walls + standards.
    let anchors = [
        ["Battery energy density 300 Wh/kg",   "300 Wh/kg"],         // H1 HARD
        ["Braess's paradox (1968)",             "Braess"],            // H5 HARD topology
        ["NHTSA FARS baseline",                 "NHTSA"],             // H9 statistical
        ["SAE J3016 (L0–L5 taxonomy)",          "SAE J3016"],         // standard
        ["ISO 26262 (ASIL A–D)",                "ISO 26262"],         // standard
        ["NCAP (crash-test protocol)",          "NCAP"],              // standard
        ["IIHS (crash-test protocol)",          "IIHS"],              // standard
        ["CA-DMV disengagement reporting",      "CA DMV"],            // regulatory
        ["Waymo public MPI",                    "Waymo"],             // operator metric
    ]
    for a in anchors {
        let label = a[0]
        let needle = a[1]
        if _file_contains(audit, needle) {
            println("  [PASS] anchor referenced: " + label)
            ok = ok + 1
        } else {
            println("  [FAIL] anchor missing: " + label + " (needle: '" + needle + "')")
            bad = bad + 1
        }
    }

    // 3. raw#10 C3 caveats: per-operator honesty (no lattice over-claim).
    //    Each operator must be present with its own caveat.
    let unproven = [
        ["L5 autonomy at scale UNVERIFIED",  "L5"],
        ["Tesla FSD = L2 supervised (not L5)", "Tesla FSD"],
        ["Cruise defunct as of 2024",          "Cruise"],
        ["Mobileye uses own REM metric",       "Mobileye"],
        ["Baidu Apollo uses own MTBF",         "Baidu Apollo"],
        ["Pony.ai PR-disclosed numbers",       "Pony.ai"],
        ["NVIDIA DRIVE platform caveat",       "NVIDIA DRIVE"],
        ["Aurora pre-commercial trials",       "Aurora"],
        ["ASIL-D requires ISO 26262 evidence", "ASIL-D"],
    ]
    for u in unproven {
        let label = u[0]
        let needle = u[1]
        if _file_contains(audit, needle) {
            println("  [PASS] honesty caveat preserved: " + label)
            ok = ok + 1
        } else {
            println("  [FAIL] honesty caveat MISSING: " + label)
            bad = bad + 1
        }
    }

    println("")
    println("  anchors verified: " + str(ok) + "  failures: " + str(bad))
    if bad > 0 {
        println("__HEXA_MOBILITY_REAL_LIMITS_ANCHOR__ FAIL")
        exit(1)
    }
    println("__HEXA_MOBILITY_REAL_LIMITS_ANCHOR__ PASS")
}
